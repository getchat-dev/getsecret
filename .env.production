# Public origin of the deployed site. Read by `next build` (Next loads
# .env.production for production builds) and inlined into the bundle by
# siteOrigin() in src/lib/site-meta.ts — canonical URLs, hreflang, OG image
# URLs, sitemap.xml, robots.txt and JSON-LD all hang off it.
#
# It lives here rather than in .env because NEXT_PUBLIC_* is frozen at BUILD
# time, and .env is not shipped into the build image (see werf.yaml
# includePaths) — so a value set there would never reach `next build` and
# every absolute URL would fall back to http://localhost:3000.
#
# A real environment variable still wins over this file, so a staging build
# can override it without editing the repo.
NEXT_PUBLIC_SITE_URL=https://getsecret.app
