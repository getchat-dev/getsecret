# Canonical host the app is served on. Everything else permanently redirects
# here. Traefik routes on it; it does NOT reach the app bundle — the public
# origin used for canonical/OG/sitemap URLs is NEXT_PUBLIC_SITE_URL in
# the committed production env file, which is baked in at build time. Keep
# the two in sync.
APP_HOST="getsecret.app"
# Retired hosts, permanently redirected to APP_HOST. Both are required: an
# empty value produces `Host(``)`, which Traefik rejects as an invalid rule
# and the whole router is dropped. To retire only one host, point both at it.
OLD_APP_HOST="burnotes.app"
OLD_APP_HOST_2="burnotes.markuper.com"
NODE_ENV=production
APP_ENV=prod
APP_PORT=3000
# Number of trusted reverse-proxy hops in front of the app (e.g., Traefik = 1).
# Set to 0 to disable header-based client-IP detection entirely.
TRUSTED_PROXY_HOPS=1

# Valkey (Redis-compatible) connection URL. The hostname `valkey` resolves
# inside the `burnotes-infra` Docker network created by docker-compose.infra.yml.
# For running `npm run dev` on the host, expose the port in the infra compose
# and use `redis://localhost:6379/0`.
VALKEY_URL=redis://valkey:6379/0

POSTGRES_USER="burnotes"
POSTGRES_PASSWORD="burnotes"
POSTGRES_DB="burnotes_prod"

# Ability to enable password protection for secrets
PASSWORD_PROTECTION_ENABLED=true

S3_ENDPOINT=https://fra1.digitaloceanspaces.com     # или ams3 / nyc3 — где Space создан
S3_REGION=fra1                                       # должен совпадать с регионом в endpoint
S3_BUCKET=burnotes-files                             # имя твоего Space
S3_ACCESS_KEY=DO00...                                # из DO console → API → Spaces Keys
S3_SECRET_KEY=...                                    # secret part пары
S3_FORCE_PATH_STYLE=false                            # DO Spaces — virtual-hosted style
MAX_FILE_SIZE_BYTES=26214400

UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_HOST=