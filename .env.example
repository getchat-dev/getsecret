APP_HOST="burnotes.markuper.com"
NODE_ENV=production
APP_ENV=prod
APP_PORT=3000
# Number of trusted reverse-proxy hops in front of the app (e.g., Traefik = 1).
# Set to 0 to disable header-based client-IP detection entirely.
TRUSTED_PROXY_HOPS=1

# Valkey (Redis-compatible) connection URL. The hostname `valkey` resolves
# inside the `burnotes-infra` Docker network created by docker-compose.infra.yml.
# For running `npm run dev` on the host, expose the port in the infra compose
# and use `redis://localhost:6379/0`.
VALKEY_URL=redis://valkey:6379/0

# Ability to enable password protection for secrets
PASSWORD_PROTECTION_ENABLED=true